// One Worker: the top level is local development, env.staging and env.production deploy (README, Deploy it).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "conquer-local",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [{ "binding": "DB", "database_name": "conquer-local", "migrations_dir": "migrations" }],
  "env": {
    "staging": {
      "name": "conquer-staging",
      "routes": [{ "pattern": "staging.gurudo.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "conquer-staging",
          // PLACEHOLDER: replace with the id of conquer-staging once the database exists.
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "conquer",
      "routes": [{ "pattern": "gurudo.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "conquer",
          // PLACEHOLDER: replace with the id of conquer once the database exists.
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
