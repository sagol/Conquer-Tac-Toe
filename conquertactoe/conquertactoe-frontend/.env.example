# ============================================
# BACKEND API CONFIGURATION
# ============================================
# URL of the backend API server
# Used by frontend to make API requests
REACT_APP_BACKEND_URL=http://localhost:3000

# ============================================
# FRONTEND URL CONFIGURATION
# ============================================
# Production URL of the frontend application
# Used for SEO meta tags, sitemaps, and robots.txt generation
REACT_APP_CLIENT_URL=http://localhost:3001

# ============================================
# DOCKER FRONTEND PORTS
# ============================================
# Port exposed on the host machine for accessing the frontend
FRONTEND_HOST_PORT=3001

# Internal port inside the Docker container
FRONTEND_CONTAINER_PORT=3000

# ============================================
# DOCKER NETWORK
# ============================================
# Docker network name for inter-service communication
NETWORK_NAME=conquer-network