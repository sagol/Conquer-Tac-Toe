# Network Name (Must match the one created earlier)
NETWORK_NAME=conquer-network

# --- Admin Backend Configuration ---
ADMIN_BACKEND_CONTAINER_NAME=conquertactoe_admin_backend
ADMIN_BACKEND_PORT=4000
ADMIN_BACKEND_INTERNAL_PORT=4000
NODE_ENV=production
LOG_LEVEL=info

# Admin Security
# Generate new secrets using: openssl rand -hex 32
ADMIN_JWT_SECRET=6f8c2e7a9b3d4f1e2c5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e # Example only, replace in production!
ADMIN_JWT_REFRESH_SECRET=7e6d5c4b3a2f1e0d9c8b7a6f5e4d3c2b1a0f9e8d7c6b5a4f3e2d1c0b9a8f7e6d # Example only, replace in production!
ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d

# Database Connection (Must match your main DB credentials)
POSTGRES_HOST=conquertactoe_db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Prod_Secure_Password_123!
POSTGRES_DB=conquertactoe

# ClickHouse Connection (Must match your Autoplayer credentials)
CLICKHOUSE_HOST=conquertactoe_clickhouse
CLICKHOUSE_NATIVE_PORT=9000

# Rate Limiting & CORS
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Ensure this matches the URL where you will access the admin frontend
ADMIN_ALLOWED_ORIGINS=https://admin.your-domain.com

# --- Admin Frontend Configuration ---
ADMIN_FRONTEND_CONTAINER_NAME=conquertactoe_admin_frontend
ADMIN_FRONTEND_PORT=3002
ADMIN_FRONTEND_INTERNAL_PORT=3000

# URLs needed by the Frontend React App
# Note: For production, use https://your-domain.com/admin-api (configured via Nginx)
# OR use the direct port if accessing via IP (not recommended)
REACT_APP_ADMIN_API_URL=https://admin.your-domain.com/api
REACT_APP_WEBSOCKET_URL=wss://admin.your-domain.com