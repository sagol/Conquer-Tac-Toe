# ============================================
# DATABASE CONFIGURATION
# ============================================
# Full PostgreSQL connection URL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/conquertactoe

# ClickHouse server hostname (Docker service name)
CLICKHOUSE_HOST=clickhouse

# ClickHouse native protocol port (default: 9000)
CLICKHOUSE_PORT=9000

# ============================================
# JWT AUTHENTICATION
# ============================================
# Secret key for admin JWT access tokens
# Generate with: openssl rand -hex 32
ADMIN_JWT_SECRET=your-super-secret-admin-key-change-in-production

# Secret key for admin JWT refresh tokens
# Generate with: openssl rand -hex 32
ADMIN_JWT_REFRESH_SECRET=your-super-secret-refresh-key

# Access token expiration time (e.g., '1h', '15m', '7d')
ACCESS_TOKEN_EXPIRY=1h

# Refresh token expiration time (e.g., '1h', '15m', '7d')
REFRESH_TOKEN_EXPIRY=7d

# ============================================
# SERVER CONFIGURATION
# ============================================
# Port number for the admin backend server
PORT=4000

# Node environment: 'development', 'production', or 'test'
NODE_ENV=development

# ============================================
# SECURITY
# ============================================
# Allowed frontend origins for CORS (comma-separated)
ADMIN_ALLOWED_ORIGINS=http://localhost:3002

# Time window for rate limiting in milliseconds (15 minutes = 900000ms)
RATE_LIMIT_WINDOW_MS=900000

# Maximum number of requests per time window
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING
# ============================================
# Logging level: 'error', 'warn', 'info', 'debug'
LOG_LEVEL=info

# ============================================
# DEFAULT ADMIN USER
# ============================================
# Default admin email (created during migration if not exists)
ADMIN_DEFAULT_EMAIL=admin@conquertactoe.com

# Default admin password (change immediately in production!)
ADMIN_DEFAULT_PASSWORD=admin123

# Default admin username
ADMIN_DEFAULT_USERNAME=admin

# ============================================
# GOOGLE OAUTH CONFIGURATION
# ============================================
# Google OAuth 2.0 Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id

# Google OAuth 2.0 Client Secret from Google Cloud Console
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth callback URL for Google authentication
# Must match the authorized redirect URI in Google Cloud Console
GOOGLE_CALLBACK_URL=http://localhost:4000/admin/auth/google/callback

# Comma-separated list of emails allowed admin access via OAuth
ADMIN_ALLOWED_EMAILS=admin@yourdomain.com,superadmin@yourdomain.com

# ============================================
# SESSION CONFIGURATION
# ============================================
# Secret key for Express session encryption
# Generate with: openssl rand -hex 32
SESSION_SECRET=your_generated_session_secret_here

# ============================================
# FRONTEND URL
# ============================================
# Admin frontend URL for OAuth redirects and CORS
ADMIN_FRONTEND_URL=http://localhost:3002
