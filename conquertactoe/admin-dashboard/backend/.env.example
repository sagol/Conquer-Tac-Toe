# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/conquertactoe
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000

# JWT Configuration
ADMIN_JWT_SECRET=your-super-secret-admin-key-change-in-production
ADMIN_JWT_REFRESH_SECRET=your-super-secret-refresh-key
ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d

# Server Configuration
PORT=4000
NODE_ENV=development

# Security
ALLOWED_ORIGINS=http://localhost:3002
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Admin User Configuration (for password-based login)
# The migration will create this user if it doesn't exist
ADMIN_DEFAULT_EMAIL=admin@conquertactoe.com
ADMIN_DEFAULT_PASSWORD=admin123
ADMIN_DEFAULT_USERNAME=admin

# OAuth Configuration (Google)
# OAuth Configuration (Google)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/admin/auth/google/callback

# Allowed Admin Emails for OAuth (comma-separated)
# Only these emails will be granted admin access via OAuth
ADMIN_ALLOWED_EMAILS=admin@yourdomain.com,superadmin@yourdomain.com

# Session Configuration
SESSION_SECRET=your_generated_session_secret_here

# Frontend URL (for OAuth redirects)
ADMIN_FRONTEND_URL=http://localhost:3002
