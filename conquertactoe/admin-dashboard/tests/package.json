{
    "name": "conquertactoe-admin-tests",
    "version": "1.0.0",
    "description": "Tests for Conquer Tac Toe Admin Dashboard",
    "scripts": {
        "test": "jest --verbose",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
    "devDependencies": {
        "@types/jest": "^29.5.0",
        "jest": "^29.5.0"
    },
    "dependencies": {
        "axios": "^1.4.0",
        "supertest": "^6.3.3"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/*.test.js"
        ],
        "coveragePathIgnorePatterns": [
            "/node_modules/"
        ],
        "testTimeout": 30000
    }
}