# ============================================
# CLICKHOUSE ANALYTICS DATABASE
# ============================================
# Docker container name for the ClickHouse service
CLICKHOUSE_CONTAINER_NAME=conquertactoe_clickhouse

# ClickHouse server hostname (Docker service name)
CLICKHOUSE_HOST=clickhouse

# ClickHouse database name for analytics
CLICKHOUSE_DB=default

# ClickHouse username for authentication
CLICKHOUSE_USER=default

# ClickHouse password (leave empty for default auth)
CLICKHOUSE_PASSWORD=

# ClickHouse HTTP interface port (default: 8123)
CLICKHOUSE_HTTP_PORT=8123

# ClickHouse native protocol port (default: 9000)
CLICKHOUSE_NATIVE_PORT=9000

# ============================================
# POSTGRESQL DATABASE
# ============================================
# PostgreSQL server hostname (Docker service name)
POSTGRES_HOST=conquertactoe_db

# PostgreSQL database name
POSTGRES_DB=conquertactoe

# PostgreSQL username for authentication
POSTGRES_USER=postgres

# PostgreSQL password for authentication
POSTGRES_PASSWORD=postgres

# Port exposed on the host machine for PostgreSQL access
POSTGRES_HOST_PORT=5433

# Internal port inside the Docker container
POSTGRES_CONTAINER_PORT=5432