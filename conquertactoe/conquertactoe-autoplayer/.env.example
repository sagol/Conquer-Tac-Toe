# ============================================
# DOCKER NETWORK
# ============================================
# Docker network name for inter-service communication
NETWORK_NAME=conquer-network

# ============================================
# AUTOPLAYER SERVICE
# ============================================
# Docker container name for the autoplayer service
AUTOPLAYER_CONTAINER_NAME=conquertactoe_autoplayer

# Port exposed for the autoplayer HTTP API
AUTOPLAYER_PORT=8000

# ============================================
# CLICKHOUSE ANALYTICS DATABASE
# ============================================
# Docker container name for the ClickHouse service
CLICKHOUSE_CONTAINER_NAME=conquertactoe_clickhouse

# ClickHouse server hostname (Docker service name)
CLICKHOUSE_HOST=clickhouse

# ClickHouse database name for storing game analytics
CLICKHOUSE_DB=default

# ClickHouse username for authentication
CLICKHOUSE_USER=default

# ClickHouse password (leave empty for default auth)
CLICKHOUSE_PASSWORD=

# ClickHouse HTTP interface port (default: 8123)
CLICKHOUSE_HTTP_PORT=8123

# ClickHouse native protocol port (default: 9000)
CLICKHOUSE_NATIVE_PORT=9000