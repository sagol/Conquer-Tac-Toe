# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL database name
POSTGRES_DB=conquertactoe

# PostgreSQL username for authentication
POSTGRES_USER=postgres

# PostgreSQL password for authentication
POSTGRES_PASSWORD=postgres

# PostgreSQL host (Docker service name or hostname)
POSTGRES_HOST=conquertactoe_db

# PostgreSQL port number
POSTGRES_PORT=5432

# Full PostgreSQL connection URL (alternative to individual params)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@conquertactoe_db:5432/conquertactoe

# ============================================
# GOOGLE OAUTH CONFIGURATION
# ============================================
# Google OAuth 2.0 Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id

# Google OAuth 2.0 Client Secret from Google Cloud Console
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth callback URL for Google authentication
# Must match the authorized redirect URI in Google Cloud Console
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ============================================
# SESSION & SECURITY
# ============================================
# Secret key for Express session encryption
# Generate with: openssl rand -hex 32
SESSION_SECRET=your_session_secret

# JWT secret for token-based authentication (if applicable)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here

# ============================================
# SERVER CONFIGURATION
# ============================================
# Port number for the backend server
PORT=3000

# Frontend URL for CORS configuration and redirects
CLIENT_URL=http://localhost:3001

# Node environment: 'development', 'production', or 'test'
NODE_ENV=development

# ============================================
# AI SERVICE CONFIGURATION
# ============================================
# URL of the AI autoplayer service for bot gameplay
# 
# DOCKER NETWORKING EXPLAINED:
# 'conquertactoe_autoplayer' is a Docker SERVICE NAME, not a traditional hostname.
# When running in Docker, containers on the same network can communicate using
# service names as hostnames. Docker's internal DNS automatically resolves
# 'conquertactoe_autoplayer' to the correct container IP address.
#
# CONFIGURATION OPTIONS:
# - Docker (default): http://conquertactoe_autoplayer:8000
#   This works when backend and autoplayer are in the same Docker network (conquer-network)
#
# - Local development (no Docker): http://localhost:8000
#   Use this if running the autoplayer service directly on your machine
#
# - Remote server: http://192.168.1.100:8000 or http://autoplayer.example.com:8000
#   Use this if the autoplayer runs on a different machine
#
AI_SERVICE_URL=http://conquertactoe_autoplayer:8000

# ============================================
# CLICKHOUSE ANALYTICS DATABASE
# ============================================
# ClickHouse server hostname or Docker service name
CLICKHOUSE_HOST=conquertactoe_clickhouse

# ClickHouse HTTP interface port (default: 8123)
CLICKHOUSE_HTTP_PORT=8123

# ClickHouse username for authentication
CLICKHOUSE_USER=default

# ClickHouse password (leave empty for default auth)
CLICKHOUSE_PASSWORD=

# ClickHouse database name for analytics
CLICKHOUSE_DB=default

# ============================================
# DOCKER NETWORK
# ============================================
# Docker network name for inter-service communication
NETWORK_NAME=conquer-network
